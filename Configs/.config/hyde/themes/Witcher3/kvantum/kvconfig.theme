$HOME/.config/Kvantum/wallbash/wallbash.kvconfig
# Witcher3 Kvantum overrides for HyDE's Wallbash SVG theme.
#
# Kvantum inherits omitted sections and non-color values from its default
# configuration. Keep this file intentionally small: HyDE continues to provide
# and render the current wallbash.svg, while Witcher3 owns only the palette and
# text-state overrides required for a red selection/accent scheme.

[%General]
author=Witcher 3 HyDE Theme contributors
comment=Witcher3 dark iron palette for HyDE Kvantum
respect_DE=true
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
joined_inactive_tabs=false
attach_active_tab=true
composite=true
translucent_windows=false
blurring=false
popup_blurring=true
animate_states=true
reduce_window_opacity=0
reduce_menu_opacity=0

[GeneralColors]
window.color=#<wallbash_pry1>
base.color=#<wallbash_1xa1>
alt.base.color=#<wallbash_1xa2>
button.color=#<wallbash_1xa2>
light.color=#<wallbash_1xa3>
mid.light.color=#<wallbash_1xa3>
dark.color=#<wallbash_pry1>
mid.color=#<wallbash_1xa2>
highlight.color=#<wallbash_4xa8>
inactive.highlight.color=#<wallbash_4xa6>
text.color=#<wallbash_txt1>
window.text.color=#<wallbash_txt1>
button.text.color=#<wallbash_txt1>
disabled.text.color=#<wallbash_1xa4>
tooltip.text.color=#<wallbash_txt1>
highlight.text.color=#<wallbash_txt4>
link.color=#<wallbash_1xa7>
link.visited.color=#<wallbash_2xa5>
progress.indicator.text.color=#<wallbash_txt4>

[Hacks]
respect_darkness=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
transparent_pcmanfm_view=false
blur_translucent=false

[PanelButtonCommand]
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[ItemView]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt4>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[Tab]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt2>
text.focus.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[HeaderSection]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt4>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[Toolbar]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[Progressbar]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt4>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[Menu]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[MenuItem]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt4>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[MenuBar]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[MenuBarItem]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt4>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>

[ComboBox]
inherits=PanelButtonCommand
text.normal.color=#<wallbash_txt1>
text.focus.color=#<wallbash_txt1>
text.press.color=#<wallbash_txt4>
text.toggle.color=#<wallbash_txt4>
