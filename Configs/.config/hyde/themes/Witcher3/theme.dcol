# Witcher3 fixed HyDE / Wallbash palette
#
# Role mapping:
#   pry1 = canvas/background
#   pry2 = surface
#   pry3 = elevated surface
#   pry4 = Witcher red selection/accent
#
# High xa slots also preserve useful semantic accents for HyDE templates:
#   1xa6 = amber/yellow
#   1xa7 = cyan/blue
#   1xa8 = Witcher red
#   2xa5 = violet
#   2xa7/2xa8 = alchemy green
#   3xa6 = muted silver
#   3xa7 = cyan/blue
#   3xa8/3xa9 = amber/yellow
#   4xa1..4xa9 = deep-red to bright-red interaction ramp

dcol_mode="dark"

dcol_pry1="0A151E"
dcol_pry1_rgba="rgba(10,21,30,\1)"
dcol_txt1="DEE6F0"
